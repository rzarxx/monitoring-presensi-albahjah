# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=absensi_db
DB_USER=absensi_user
DB_PASSWORD=replace-with-a-strong-database-password

# ZKTeco device
ZK_IP=192.168.1.100
ZK_PORT=4370
MOCK_ZK=false

# First administrator, used only when the admins table has no records
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password

# Generate a unique, long random value for each environment
JWT_SECRET=replace-with-a-long-random-secret

# Public application URL; NEXT_PUBLIC values are embedded during npm run build
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret khusus untuk cron server yang memicu sinkronisasi incremental terjadwal.
# Buat nilai acak panjang, jangan pernah kirim ke browser atau commit ke Git.
SYNC_CRON_TOKEN=replace-with-a-long-random-scheduler-token
